# Copy to .env and adjust. .env is gitignored; this file is committed and is the
# canonical list of every BIB_ key with a safe local value. Adding a config key
# means adding it here AND in src/config/config.ts (the schema) — nowhere else
# reads the environment.

# ── Runtime ──────────────────────────────────────────────────────────────────
# REQUIRED, with no default. It decides whether the dev x-user-id header is
# accepted as identity, whether /docs is served, whether the session cookie is
# Secure and whether the logging mailer is allowed — so an unset value is a
# question nobody answered, and the process refuses to boot rather than guess.
BIB_ENVIRONMENT=development          # development | qa | uat | production
BIB_LOG_LEVEL=debug                  # debug | info | warn | error
BIB_PORT=8080

# ── Postgres ───────────────────────────────────────────────────────────────
# owner — runs migrations only, off the request path. Superuser locally.
BIB_DATABASE_URL=postgres://bib_owner:bib_local_dev@localhost:5432/bib
# app — every business query. NOBYPASSRLS. The tenant wall depends on this role
# being unable to see across tenants.
BIB_APP_DATABASE_URL=postgres://bib_app:app_local_dev@localhost:5432/bib

# ── Connection pools ─────────────────────────────────────────────────────────
BIB_DB_POOL_APP=10
BIB_DB_POOL_OWNER=2

# ── API docs ─────────────────────────────────────────────────────────────────
# Serve the OpenAPI spec (/openapi.json) and Swagger UI (/docs). Leave unset to
# get the default: on for development, OFF for qa/uat/production (the spec lists
# every endpoint, so a public environment must opt in). Set true|false to force.
# BIB_DOCS_ENABLED=true

# ── Auth / sessions (T1.7) ───────────────────────────────────────────────────
BIB_SESSION_COOKIE_NAME=bib_session
# Lax when the app and the API share a registrable domain (the intended setup).
# None is REQUIRED when they do not — e.g. two Cloud Run services, since
# *.run.app is a public suffix and each service is its own site. With Lax there,
# the browser never sends the cookie and every call is "no authenticated
# session" straight after a successful login. None demands Secure; boot refuses
# the pair. CSRF is still covered by the Origin guard (src/api/origin.ts).
BIB_SESSION_COOKIE_SAMESITE=Lax
# Leave unset for the default: Secure on in production-like, off locally (a
# Secure cookie is dropped over plain http and would break local dev silently).
# BIB_SESSION_COOKIE_SECURE=true
# The FRONTEND's origin — magic links point at its redemption page, not at this
# API, so it cannot be inferred from the request.
BIB_APP_BASE_URL=http://localhost:3000
# The honest registry. When true, an x-user-id header is accepted as a principal
# — convenient locally, and refused at boot in qa/uat/production.
# BIB_DEV_AUTH_ENABLED=true
# 'log' writes the magic link to the log instead of sending it, which is right
# locally and is refused at boot in qa/uat/production. 'smtp' is the real one.
#
# It is plain SMTP on purpose rather than a vendor SDK: Google Workspace,
# Microsoft 365, Amazon SES and Postmark all speak it, so the firm's existing
# mailbox works and no adapter has to be rewritten when the provider changes.
#
# With 'smtp', BIB_MAIL_FROM and BIB_SMTP_HOST are REQUIRED — boot refuses
# without them, in every environment, and names the one that is missing.
BIB_MAIL_TRANSPORT=log
# The address the letters come from. Use one at a domain the CLIENT recognises:
# a portal invite arrives unasked, and an unfamiliar sender reads as phishing.
# BIB_MAIL_FROM=no-reply@10xglobal.in
# BIB_MAIL_FROM_NAME=10x Global
# The relay. 587 is submission with STARTTLS and is the default; 465 is implicit
# TLS, and BIB_SMTP_SECURE defaults to true only for that port.
# BIB_SMTP_HOST=smtp.gmail.com
# BIB_SMTP_PORT=587
# BIB_SMTP_USER=no-reply@10xglobal.in
# BIB_SMTP_PASSWORD=an app password, never the account's own
# BIB_SMTP_SECURE=false
# How an engagement letter gets signed. Only 'attested' exists: a person at the
# firm records that the client signed, on paper or through a provider the firm
# already uses. It records an assertion rather than a signature, so a
# production-like environment refuses to boot on it — an engagement letter
# creates obligations and a colleague's word is not evidence of one.
BIB_ESIGN_PROVIDER=attested
# DocuSign (BIB_ESIGN_PROVIDER=docusign). Unset locally: the API refuses to wire
# the signer without all three, and `attested` needs none of them. The OAuth base
# MUST carry its scheme — the JWT's `aud` is derived from it with new URL().
# An integration key lives in exactly ONE environment: sandbox keys work only
# against https://account-d.docusign.com, production keys only against
# https://account.docusign.com.
# BIB_DOCUSIGN_OAUTH_BASE=https://account-d.docusign.com
# BIB_DOCUSIGN_INTEGRATION_KEY=
# BIB_DOCUSIGN_USER_ID=
# Optional: discovered from /oauth/userinfo when unset, which is the ordinary
# single-account case.
# BIB_DOCUSIGN_ACCOUNT_ID=
# BIB_DOCUSIGN_PRIVATE_KEY=
# Where uploaded document bytes live (T3.6). Only 'filesystem' exists: files on
# the local disk. It is a STUB and a production-like environment refuses to boot
# on it, for two reasons worth knowing rather than rediscovering — two replicas
# do not share a filesystem, so a file uploaded through one pod is a 500 through
# the other; and a container filesystem does not survive a restart, which would
# leave the product listing documents whose bytes are gone.
BIB_STORAGE_BACKEND=filesystem
BIB_STORAGE_ROOT=.data/blobs
# Cloud Storage (BIB_STORAGE_BACKEND=gcs). The bucket is required by the process
# that BUILDS the store — the API. The worker names a backend to satisfy
# validateServer and constructs none, so it needs no bucket.
# BIB_GCS_BUCKET=
# BIB_GCS_TIMEOUT_MS=20000
# The largest file the store accepts. A MEMORY BUDGET, not a preference: the
# whole file is held in memory to be hashed before it is written, so this is what
# one upload request can cost the process.
BIB_MAX_UPLOAD_BYTES=26214400
# The provisioning callers. Each gets its OWN key carrying only what it needs —
# one key that opens every route is an escalation path (create a user, grant
# them partner, set their password, sign in as them). JSON:
#   [{"name": "...", "key": "32+ chars", "capabilities": [...]}]
# Capabilities: tenant.provision, user.provision, membership.grant, credential.set
#
# This local value is committed and therefore public: fine on a laptop, refused
# at boot in qa/uat/production. There, credential.set must sit on a key of its
# own — it grants a login as somebody. Generate: openssl rand -hex 32

# ── Rate limiting ────────────────────────────────────────────────────────────
# Whether X-Forwarded-For may be believed. Must match the deployment: behind a
# load balancer, false means every client shares the balancer's address and one
# bucket throttles everyone; with no proxy in front, true lets any client invent
# its own key per request and opt out of rate limiting entirely.
BIB_TRUST_PROXY=false
# HOW MANY proxies, when they ARE trusted. X-Forwarded-For is a list the client
# starts and each hop appends to, so only the right-hand entries mean anything:
# this says how far in from that end the real client sits. One load balancer is
# 1; a CDN in front of one is 2. Setting it higher than the truth reads an entry
# the caller wrote and hands them a fresh rate-limit bucket per request.
BIB_TRUSTED_PROXY_HOPS=1
# Per client, per minute. The auth bucket covers the unauthenticated sign-in
# routes — the expensive, guessable ones.
BIB_RATELIMIT_AUTH_PER_MINUTE=10
BIB_RATELIMIT_GENERAL_PER_MINUTE=300

# ── CORS ─────────────────────────────────────────────────────────────────────
# Browser origins allowed to call the API with credentials. Comma-separated,
# EXACT matches — a wildcard is refused at boot because it cannot be combined
# with credentialed requests. Unset falls back to BIB_APP_BASE_URL.
# BIB_CORS_ORIGINS=http://localhost:3000
BIB_INTERNAL_KEYS='[{"name":"local-dev","key":"local-dev-internal-key-not-for-any-real-environment","capabilities":["tenant.provision","user.provision","membership.grant","credential.set"]}]'

# ── The worker (T2.6) ────────────────────────────────────────────────────────
# A SEPARATE PROCESS from the API — `npm run worker`. Compliance work runs for
# months and pauses on a human decision, which does not belong in a request.
# It reads the same BIB_APP_DATABASE_URL; pg-boss keeps its own queue tables in
# a `pgboss` schema it creates and migrates itself, so the role needs DDL rights
# there on first start and on any pg-boss upgrade.
#
# When the spawn sweep runs — a cron expression, because "every morning at six"
# is a business cadence and an interval drifts. Hourly by default: the sweep only
# has to be finer than the lead times it feeds.
BIB_WORKER_SPAWN_CRON=0 * * * *
# The dunning sweep. DAILY, not hourly: the ladder's rungs are counted in days,
# so a more frequent sweep re-reads the same answer — and a chaser landing at
# 3am is the one thing it would change.
BIB_WORKER_DUNNING_CRON=0 7 * * *

# How often the orchestrator looks for work that became ready (T2.7). Finer than
# the other two: a colleague is waiting for the next step, not a clock.
BIB_WORKER_ORCHESTRATOR_CRON=*/5 * * * *
# The compliance calendar (T3.2). Once a day: a statutory date does not move
# between breakfast and lunch, and the sweep already materialises a year ahead.
BIB_WORKER_OBLIGATION_CRON=15 2 * * *
# The escalation ladder (T4.5), after the calendar has generated and while there
# is still a working day left to act on what it says. Daily, like the dunning
# ladder and for the same reason: the rungs are counted in days.
BIB_WORKER_ESCALATION_CRON=15 6 * * *
# How long a shutdown waits for a sweep already in flight. A sweep halfway
# through a firm must be allowed to finish; the bound stops a wedged handler
# holding a deploy open forever.
BIB_WORKER_SHUTDOWN_GRACE_MS=45000

# ── Which build is running (V0.2) ────────────────────────────────────────────
# Reported by GET /health. The Dockerfile sets both from its COMMIT_SHA and
# BUILD_TIME build args (cloudbuild.yaml passes them), so a deployment never
# sets these by hand. Unset locally, /health says null. Set them to check the
# report without building an image:
# BIB_BUILD_COMMIT=32fbca3c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a
# BIB_BUILD_TIME=2026-09-28T18:30:00Z
