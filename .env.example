# Copy to .env and adjust. .env is gitignored; this file is committed and is the
# canonical list of every BIB_ key with a safe local value. Adding a config key
# means adding it here AND in src/config/config.ts (the schema) — nowhere else
# reads the environment.

# ── Runtime ──────────────────────────────────────────────────────────────────
BIB_ENVIRONMENT=development          # development | qa | uat | production
BIB_LOG_LEVEL=debug                  # debug | info | warn | error
BIB_PORT=8080

# ── Postgres ───────────────────────────────────────────────────────────────
# owner — runs migrations only, off the request path. Superuser locally.
BIB_DATABASE_URL=postgres://bib_owner:bib_local_dev@localhost:5432/bib
# app — every business query. NOBYPASSRLS. The tenant wall depends on this role
# being unable to see across tenants.
BIB_APP_DATABASE_URL=postgres://bib_app:app_local_dev@localhost:5432/bib

# ── Connection pools ─────────────────────────────────────────────────────────
BIB_DB_POOL_APP=10
BIB_DB_POOL_OWNER=2

# ── API docs ─────────────────────────────────────────────────────────────────
# Serve the OpenAPI spec (/openapi.json) and Swagger UI (/docs). Leave unset to
# get the default: on for development, OFF for qa/uat/production (the spec lists
# every endpoint, so a public environment must opt in). Set true|false to force.
# BIB_DOCS_ENABLED=true
