{
  "name": "bib-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/cmd/server.ts",
    "build": "tsup",
    "start": "node dist/cmd/server.js",
    "worker": "tsx watch src/cmd/worker.ts",
    "worker:once": "tsx src/cmd/worker-once.ts",
    "worker:start": "node dist/cmd/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "smoke": "bash scripts/smoke.sh",
    "demo": "bash scripts/demo-seed.sh",
    "demo:fresh": "bash scripts/demo-fresh.sh",
    "demo:verify": "bash scripts/demo-verify.sh",
    "migrate": "tsx src/cmd/migrate.ts",
    "check": "npm run typecheck && npm run lint && npm run arch && npm run test",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@hono/node-server": "^1.13.7",
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^0.19.10",
    "@pdf-lib/fontkit": "^1.1.1",
    "dotenv": "^16.6.1",
    "hono": "^4.6.14",
    "nodemailer": "^9.1.1",
    "pdf-lib": "^1.17.1",
    "pg-boss": "^12.28.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "regenerator-runtime": "^0.14.1",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ]
  }
}
